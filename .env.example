# Optional: absolute path to Codex CLI. Defaults to `codex` on PATH.
CODEX_BIN=
# Optional: database path. Defaults to ./data/quotapilot.sqlite.
QUOTAPILOT_DB=
# Server-only Nebius Token Factory credentials. Copy to .env.local and fill in.
NEBIUS_API_KEY=
NEBIUS_NEMOTRON_MODEL=
# Optional JSON keyed by exact model IDs from the live Codex catalog.
# Tiers 1/2/3 and capabilities are operator-evaluated, not inferred from names.
QUOTAPILOT_MODEL_PROFILES={}
# Optional feature flag; each task also requires explicit opt-in in the form.
QUOTAPILOT_AUTO_ESCALATE=0
